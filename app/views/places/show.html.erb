

<div class="container py-4">
  <h1 class="mb-1"><%= @place["name"] %></h1>
  <h2 class="mb-4">My Entries</h2>

  <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <% for entry in @entries %>
      <div class="col">
        <div class="card h-100">
          <% if entry.uploaded_image.attached? %>
            <img src="<%= url_for(entry.uploaded_image) %>" class="card-img-top">
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= entry["title"] %></h5>
            <h6 class="card-subtitle mb-2 text-muted"><%= entry["occurred_on"] %></h6>
            <p class="card-text"><%= entry["description"] %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-3">
    <a href="/entries/new?place_id=<%= @place["id"] %>" class="btn btn-primary">New Entry</a>
    <a href="/places" class="btn btn-outline-secondary">Back to All Places</a>
  </div>
</div>